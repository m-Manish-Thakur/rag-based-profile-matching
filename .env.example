# Copy this file to .env and fill in values as needed.

# --- HuggingFace (optional) ---
# Token raises rate limits when downloading embedding models.
# Get one free at https://huggingface.co/settings/tokens
# Without it everything still works — just slower downloads.
HF_TOKEN=

# Where downloaded models are cached (defaults to ~/.cache/huggingface)
# HF_HOME=C:\Users\you\.cache\huggingface

# --- Embedding model ---
# Model used for generating embeddings. Must be a sentence-transformers model.
# Options: all-MiniLM-L6-v2 (default, fast) | all-mpnet-base-v2 (better, slower)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector database ---
# Directory where ChromaDB persists data (created automatically).
CHROMA_DIR=chroma_db

# --- OpenAI (optional — only if you swap to OpenAI embeddings) ---
# Uncomment and set if you modify the code to use OpenAI instead of HuggingFace.
# OPENAI_API_KEY=sk-...
